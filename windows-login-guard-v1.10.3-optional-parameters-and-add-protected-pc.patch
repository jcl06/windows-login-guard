+    def _create_protected_pc_installer(self) -> None:
+        if self.protected_pc_installer_in_progress:
+            return
+
+        dialog = ProtectedPcInstallerDialog(self.root)
+        self.root.wait_window(dialog)
+        if dialog.result is None:
+            return
+
+        request = dict(dialog.result)
+        output_path = str(request.pop("output_path"))
+        self.protected_pc_installer_in_progress = True
+        self._set_busy(True)
+        self._set_status(
+            "Creating protected-PC installer...",
+            "information",
+        )
+        future = self.executor.submit(
+            self.client.create_protected_pc_installer,
+            str(request["label"]),
+            int(request["valid_hours"]),
+        )
+        future.add_done_callback(
+            lambda completed: self.ui_queue.put(
+                (
+                    "create_protected_pc_installer",
+                    completed,
+                    {
+                        "output_path": output_path,
+                        "label": str(request["label"]),
+                    },
+                )
+            )
+        )
+
+    def _apply_protected_pc_installer_result(
+        self,
+        future: Future[Any],
+        context: dict[str, Any],
+    ) -> None:
+        self.protected_pc_installer_in_progress = False
